{
  "name": "penta-bot",
  "private": true,
  "version": "1.0.0",
  "description": "Discord bot using discord.js",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
